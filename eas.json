{
  "cli": {
    "version": ">= 12.0.0",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "ios-dev": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "bundleIdentifier": "com.womanownedwallet.summercamp.dev"
      }
    },
    "ios-prod": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "bundleIdentifier": "com.womanownedwallet.summercamp",
        "buildConfiguration": "Release"
      }
    },
    "android": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "ios-prod": {
      "ios": {
        "appleId": "ericka@higherrealmsdigital.com",
        "ascAppId": "6767265853",
        "appleTeamId": "P39QR5M7WC"
      }
    }
  }
}
