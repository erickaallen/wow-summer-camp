{
  "cli": {
    "version": ">= 12.0.0",
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "local"
  },
  "build": {
    "ios-dev": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      },
      "channel": "ios-dev"
    },
    "ios-prod": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release"
      },
      "channel": "ios-prod"
    },
    "android": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "android"
    },
    "android-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "android"
    }
  }
}
