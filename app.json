{
  "expo": {
    "name": "WOW Summer Camp",
    "slug": "wow-summer-camp",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#7DCEF0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.womanownedwallet.summercamp",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F03E8C"
      },
      "package": "com.womanownedwallet.summercamp",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F03E8C",
          "sounds": []
        }
      ],
      "expo-font",
      [
        "expo-video",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false
        }
      ],
      "./plugins/remove-android-permissions"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9b5aa04c-c366-4ebe-a859-9181968fdd66"
      },
      "privacyPolicyUrl": "https://www.womanownedwallet.com/policies/privacy-policy"
    },
    "owner": "higher-realms-digital",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9b5aa04c-c366-4ebe-a859-9181968fdd66"
    }
  }
}
