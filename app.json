{
  "expo": {
    "name": "WOW Summer Camp",
    "slug": "wow-summer-camp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#7DCEF0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.womanownedwallet.wowsummercamp",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to show you where you are on the venue map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F03E8C"
      },
      "package": "com.womanownedwallet.wowsummercamp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to show you where you are on the venue map."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F03E8C",
          "sounds": []
        }
      ],
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9b5aa04c-c366-4ebe-a859-9181968fdd66"
      },
      "privacyPolicyUrl": "https://www.womanownedwallet.com/policies/privacy-policy"
    },
    "owner": "higher-realms-digital"
  }
}
